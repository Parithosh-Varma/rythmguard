# QNX IFS buildfile (aarch64le virt) — judges: this + qemu/run-qnx.sh is the target proof
[search=/proc/boot:/bin:/usr/bin] libs:/proc/boot:/lib:/usr/lib:/lib/dll
[virtual=aarch64le,elf] .bootstrap = {
    startup-virt -v
    PATH=/proc/boot procnto-smp-instr -v
    mqueue-resmgr
    io-pkt-v6-hc -d virtio_net
    devc-ser8250 -e -F -S -b115200 0x9000000,64
    pipe
}

[+script] .script = {
    procmgr_symlink ../../proc/boot/libc.so.1 /usr/lib/ldqnx.so.1
    display_msg "PulseGuard target boot (SIMULATION ONLY)"
    slogger2 &
    waitfor /dev/slog2info
    # QNX-specific: controller at FIFO prio 20 (see src/controller/main.c)
    on -p 20 ./controller &
    ./sensor_sim &
    ./resmgr &          # registers /dev/pulseguard/status
    ./watchdog &
    ./telemetry &       # if python on target; else native port
    reopen /dev/con1
    [+session] TERM=qansi sh &
}

[type=link] /tmp=/dev/shmem
# binaries packed from build-qnx/ (see qemu/build-qnx.sh):
#   qcc -V gcc_ntoaarch64le ...
[data=c] controller=build-qnx/controller
[data=c] sensor_sim=build-qnx/sensor_sim
[data=c] resmgr=build-qnx/resmgr
[data=c] watchdog=build-qnx/watchdog
[data=c] fault_injector=build-qnx/fault_injector
